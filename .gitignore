# rust build artefacts
/target/
*.rs.bk
*.pdb

# ide and os specific files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
._*
Thumbs.db

# environment variables
.env
.env.*
.env.local

# log files and reports
*.log
coverage/
junit.xml

# node.js wrapper artefacts
# ignore node_modules in any subdirectory
**/node_modules/

# ignore npm/yarn debug logs anywhere
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# generated files in the npm wrapper package directory
# these are prepared for publishing and should not be committed.
/commit-wizard-npm/*.node
/commit-wizard-npm/linux-x64-gnu/
/commit-wizard-npm/x86_64-unknown-linux-gnu/
/commit-wizard-npm/npm/*/*.node
/commit-wizard-npm/npm/*/commit-wizard
/commit-wizard-npm/npm/*/commit-wizard.exe

# miscellaneous build artefacts or temporary files
*.bak
*.tmp

# local test repositories
/node_test_repo/
/test-repo/

# generated release artifacts
release-binaries/
artifacts/
commit-wizard-*
# but allow the source directories
!commit-wizard-core/
!commit-wizard-cli/
!commit-wizard-npm/
# and specifically ignore generated files within it
commit-wizard-npm/index.js
commit-wizard-npm/index.d.ts
commit-wizard-npm/*.node
commit-wizard-npm/target/
*.tar.gz
*.zip

# additional caches and logs
.cargo-cache
*.tgz
*.stackdump
report.*.json
*.pdb

# additional platform-specific files
Desktop.ini
*.lnk
*.icloud
Icon

# test and coverage reports
junit.xml
report.json

# build and compilation outputs
*.exe
*.dll
*.so
*.dylib

# Planning docs
REWRITE_PLAN.md
IMPLEMENTATION_PLAN.md
